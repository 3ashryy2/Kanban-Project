# Workspace-wide Git Ignore File

# OS/System files
.DS_Store
Thumbs.db

# IDEs and Editors
.idea/
.history/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Backend (Maven / Java / Spring Boot)
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/*.ear
backend/*.log
backend/run*.log

# Frontend (Node / Angular / Playwright)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/
frontend/npm-debug.log
frontend/yarn-error.log
frontend/test-results/
frontend/playwright-report/
frontend/__screenshots__/
frontend/coverage/
frontend/connect.lock
frontend/libpeerconnection.log
frontend/testem.log
frontend/typings/
